# --- Required ---
DATABASE_URL="postgresql://crm:crm@localhost:5432/midigital_crm?schema=public"
JWT_SECRET="replace-me-with-a-long-random-string"

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# --- Automation engine ---
# Daily at 6:00am server time. Set DISABLE_CRON=true to turn the in-process job off.
AUTOMATION_CRON="0 6 * * *"
DISABLE_CRON=false
# Shared secret for POST /api/internal/run-automation, for hosts that sleep the process
AUTOMATION_SECRET=""

# --- Email notifications (optional; logs to console when unset) ---
RESEND_API_KEY=""
MAIL_FROM="MiDigitalExpansion CRM <crm@midigitalexpansion.com>"

# --- File storage (optional; uploads are disabled when unset) ---
# For Cloudflare R2 set S3_ENDPOINT to https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Seed ---
SEED_PASSWORD="changeme123"
