// MiDigitalExpansion CRM — data model
//
// Design note: the whole point of this schema is to make ladder progression and
// MRR impossible to forget. `Client.currentTier` + `ServiceHistoryEntry` give a
// live snapshot and an audit trail; `Client.websiteLaunchDate` is the anchor the
// automation engine uses to fire upsell reminders; `Retainer` is deliberately
// separate from `currentTier` so a lapsed retainer can never silently inflate MRR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------
// ENUMS
// ---------------------------

enum ServiceTierType {
  PROSPECT // not yet a client
  WEBSITE_BUILD // actively building the site
  WEBSITE_LIVE // site shipped, no retainer yet -- DANGER ZONE, biggest revenue leak
  BRAND_CURATION // subscribed to brand tier
  SOCIAL_MEDIA // subscribed to social tier (includes brand)
  ANALYTICS // full ladder, top tier
  CHURNED // no longer a client
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  SNOOZED
  CANCELLED
}

enum TaskType {
  MANUAL
  AUTO_UPSELL_PITCH
  AUTO_CHECK_IN
  AUTO_INVOICE_REMINDER
  AUTO_CONTRACT_RENEWAL
  BUILD_MILESTONE
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  TEXT
  SITE_VISIT
  OTHER
}

enum RetainerStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PENDING_FIRST_PAYMENT
}

enum UserRole {
  SALES // Cole
  TECHNICAL // Brian
}

/// Which date an automation rule counts its days from.
/// TIER_CHANGE  -> websiteLaunchDate when the trigger tier is WEBSITE_LIVE, otherwise
///                 the most recent ServiceHistoryEntry into the trigger tier.
/// RETAINER_START -> the start date of the client's active retainer (recurring rules).
/// RETAINER_END   -> a retainer's endDate; use a negative daysAfterTrigger to fire before it.
enum RuleAnchor {
  TIER_CHANGE
  RETAINER_START
  RETAINER_END
}

// ---------------------------
// CORE MODELS
// ---------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  assignedTasks       Task[]                @relation("AssignedTasks")
  createdInteractions Interaction[]
  ownedClients        Client[]              @relation("AccountOwner")
  tierChanges         ServiceHistoryEntry[] @relation("TierChangedBy")
}

model Client {
  id                String          @id @default(cuid())
  businessName      String
  industry          String? // e.g. "Restaurant", "Retail", "Dental", "Landscaping"
  websiteUrl        String?
  address           String?
  city              String?
  state             String?         @default("MI")
  zip               String?
  currentTier       ServiceTierType @default(PROSPECT)
  accountOwnerId    String? // usually Cole
  accountOwner      User?           @relation("AccountOwner", fields: [accountOwnerId], references: [id])
  websiteLaunchDate DateTime? // critical field -- drives the auto-upsell timer
  notes             String?         @db.Text
  logoUrl           String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  contacts       Contact[]
  retainers      Retainer[]
  tasks          Task[]
  interactions   Interaction[]
  serviceHistory ServiceHistoryEntry[]
  documents      Document[]
  deals          Deal[]

  @@index([currentTier])
  @@index([accountOwnerId])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  title     String? // "Owner", "Manager"
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Retainer {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tier          ServiceTierType // which service this retainer covers
  monthlyAmount Decimal         @db.Decimal(10, 2)
  status        RetainerStatus  @default(PENDING_FIRST_PAYMENT)
  startDate     DateTime?
  endDate       DateTime?
  billingDay    Int? // day of month invoice goes out, 1-28
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clientId])
  @@index([status])
}

model ServiceHistoryEntry {
  id          String           @id @default(cuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromTier    ServiceTierType?
  toTier      ServiceTierType
  changedAt   DateTime         @default(now())
  changedById String?
  changedBy   User?            @relation("TierChangedBy", fields: [changedById], references: [id])
  note        String?

  @@index([clientId, toTier, changedAt])
}

model Task {
  id            String          @id @default(cuid())
  clientId      String?
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  description   String?         @db.Text
  type          TaskType        @default(MANUAL)
  status        TaskStatus      @default(OPEN)
  dueDate       DateTime?
  assignedToId  String?
  assignedTo    User?           @relation("AssignedTasks", fields: [assignedToId], references: [id])
  completedAt   DateTime?
  snoozedUntil  DateTime?
  createdAt     DateTime        @default(now())
  autoGenerated Boolean         @default(false)
  sourceRuleId  String?
  sourceRule    AutomationRule? @relation(fields: [sourceRuleId], references: [id])

  @@index([clientId])
  @@index([assignedToId, status])
  @@index([sourceRuleId])
}

model Interaction {
  id         String          @id @default(cuid())
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       InteractionType
  summary    String          @db.Text
  occurredAt DateTime        @default(now())
  loggedById String?
  loggedBy   User?           @relation(fields: [loggedById], references: [id])
  createdAt  DateTime        @default(now())

  @@index([clientId, occurredAt])
}

model Deal {
  // For prospects not yet converted to full clients -- lightweight pipeline before "Client" record is created
  id             String   @id @default(cuid())
  businessName   String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  source         String? // "referral", "cold outreach", "instagram DM", etc.
  stage          String   @default("New") // New, Contacted, Quoted, Won, Lost
  estimatedValue Decimal? @db.Decimal(10, 2)
  notes          String?  @db.Text
  clientId       String? // set once converted
  client         Client?  @relation(fields: [clientId], references: [id])
  createdAt      DateTime @default(now())
  stageChangedAt DateTime @default(now())
  lostReason     String?

  @@index([stage])
}

model Document {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String // S3/R2 object key or URL
  storageKey String?
  category   String? // "contract", "invoice", "brand asset", "screenshot"
  uploadedAt DateTime @default(now())

  @@index([clientId])
}

model AutomationRule {
  id                String           @id @default(cuid())
  name              String // "Pitch brand curation after site launch"
  /// null means "any tier" (used by the retainer-anchored rules)
  triggerTier       ServiceTierType?
  /// which date the countdown starts from
  anchor            RuleAnchor       @default(TIER_CHANGE)
  daysAfterTrigger  Int // e.g. 45 days after websiteLaunchDate; negative fires before a RETAINER_END anchor
  /// when set, the rule re-fires this many days after the last task it generated
  repeatEveryDays   Int?
  /// only fire for clients that currently have an ACTIVE retainer
  requiresActiveRetainer Boolean     @default(false)
  taskTitleTemplate String // "Pitch {{tier}} to {{businessName}}"
  taskType          TaskType         @default(AUTO_UPSELL_PITCH)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())

  generatedTasks Task[]
}
