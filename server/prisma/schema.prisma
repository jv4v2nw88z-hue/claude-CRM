// MiDigitalExpansion CRM — data model (Cloudflare D1 / SQLite)
//
// Design note: the whole point of this schema is to make ladder progression and
// MRR impossible to forget. `Client.currentTier` + `ServiceHistoryEntry` give a
// live snapshot and an audit trail; `Client.websiteLaunchDate` is the anchor the
// automation engine uses to fire upsell reminders; `Retainer` is deliberately
// separate from `currentTier` so a lapsed retainer can never silently inflate MRR.
//
// D1 note: SQLite has no native enum type, so every field that was a Postgres
// enum is a String here. The allowed values live in `src/domain/enums.ts` as
// const objects + string-union types, and every write path is validated by Zod
// (`src/utils/validation.ts`) before it reaches the database — so the set of
// legal values is still enforced, just one layer up. Money is Float rather than
// Decimal for the same reason (SQLite has no fixed-point type); every amount in
// this app is a whole-dollar monthly figure well inside exact float range.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

// No `url` here by design: in Prisma 7 the connection is supplied by the driver
// adapter, and this app's only adapter is `PrismaD1` wrapping the Worker's D1
// binding. The CLI never needs a connection string either — migrations are
// generated with `prisma migrate diff` (schema-to-SQL, no database involved)
// and applied by `wrangler d1 migrations apply`.
datasource db {
  provider = "sqlite"
}

// ---------------------------
// CORE MODELS
// ---------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// UserRole: SALES | TECHNICAL
  role         String
  createdAt    DateTime @default(now())

  assignedTasks       Task[]                @relation("AssignedTasks")
  createdInteractions Interaction[]
  ownedClients        Client[]              @relation("AccountOwner")
  tierChanges         ServiceHistoryEntry[] @relation("TierChangedBy")
}

model Client {
  id           String  @id @default(cuid())
  businessName String
  industry     String? // e.g. "Restaurant", "Retail", "Dental", "Landscaping"
  websiteUrl   String?
  address      String?
  city         String?
  state        String? @default("MI")
  zip          String?
  /// ServiceTierType
  currentTier  String  @default("PROSPECT")

  accountOwnerId    String? // usually Cole
  accountOwner      User?     @relation("AccountOwner", fields: [accountOwnerId], references: [id])
  websiteLaunchDate DateTime? // critical field -- drives the auto-upsell timer
  notes             String?
  logoUrl           String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contacts       Contact[]
  retainers      Retainer[]
  tasks          Task[]
  interactions   Interaction[]
  serviceHistory ServiceHistoryEntry[]
  documents      Document[]
  deals          Deal[]

  @@index([currentTier])
  @@index([accountOwnerId])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  title     String? // "Owner", "Manager"
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Retainer {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// ServiceTierType — which service this retainer covers
  tier     String

  monthlyAmount Float
  /// RetainerStatus
  status        String    @default("PENDING_FIRST_PAYMENT")
  startDate     DateTime?
  endDate       DateTime?
  billingDay    Int? // day of month invoice goes out, 1-28
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}

model ServiceHistoryEntry {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// ServiceTierType — null for the very first entry
  fromTier String?
  /// ServiceTierType
  toTier   String

  changedAt   DateTime @default(now())
  changedById String?
  changedBy   User?    @relation("TierChangedBy", fields: [changedById], references: [id])
  note        String?

  @@index([clientId, toTier, changedAt])
}

model Task {
  id          String  @id @default(cuid())
  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// TaskType
  type        String  @default("MANUAL")
  /// TaskStatus
  status      String  @default("OPEN")

  dueDate       DateTime?
  assignedToId  String?
  assignedTo    User?           @relation("AssignedTasks", fields: [assignedToId], references: [id])
  completedAt   DateTime?
  snoozedUntil  DateTime?
  createdAt     DateTime        @default(now())
  autoGenerated Boolean         @default(false)
  sourceRuleId  String?
  sourceRule    AutomationRule? @relation(fields: [sourceRuleId], references: [id])

  @@index([clientId])
  @@index([assignedToId, status])
  @@index([sourceRuleId])
  @@index([status, dueDate])
}

model Interaction {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// InteractionType
  type     String

  summary    String
  occurredAt DateTime @default(now())
  loggedById String?
  loggedBy   User?    @relation(fields: [loggedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([clientId, occurredAt])
}

model Deal {
  // For prospects not yet converted to full clients -- lightweight pipeline before "Client" record is created
  id             String   @id @default(cuid())
  businessName   String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  source         String? // "referral", "cold outreach", "instagram DM", etc.
  stage          String   @default("New") // New, Contacted, Quoted, Won, Lost
  estimatedValue Float?
  notes          String?
  clientId       String? // set once converted
  client         Client?  @relation(fields: [clientId], references: [id])
  createdAt      DateTime @default(now())
  stageChangedAt DateTime @default(now())
  lostReason     String?

  @@index([stage])
  @@index([clientId])
}

model Document {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String // R2 object key, or a public URL when R2_PUBLIC_BASE_URL is set
  storageKey String?
  category   String? // "contract", "invoice", "brand asset", "screenshot"
  uploadedAt DateTime @default(now())

  @@index([clientId])
}

model AutomationRule {
  id   String @id @default(cuid())
  name String // "Pitch brand curation after site launch"
  /// ServiceTierType — null means "any tier" (used by the retainer-anchored rules)
  triggerTier String?
  /// RuleAnchor — which date the countdown starts from
  anchor      String  @default("TIER_CHANGE")

  /// e.g. 45 days after websiteLaunchDate; negative fires before a RETAINER_END anchor
  daysAfterTrigger Int
  /// when set, the rule re-fires this many days after the last task it generated
  repeatEveryDays  Int?
  /// only fire for clients that currently have an ACTIVE retainer
  requiresActiveRetainer Boolean @default(false)

  taskTitleTemplate String // "Pitch {{tier}} to {{businessName}}"
  /// TaskType
  taskType          String   @default("AUTO_UPSELL_PITCH")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  generatedTasks Task[]
}
