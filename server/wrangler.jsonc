{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Matches the Worker that actually exists in the account. The dashboard
  // derived it from the repository name (claude-CRM -> claudecrm) when the Git
  // build was connected, and that is the Worker serving the live URL — a
  // different name here would deploy a *second*, empty Worker alongside it and
  // leave the real one untouched.
  "name": "claudecrm",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // The React build is served by this same Worker, which is the whole reason the
  // session cookie can stay SameSite=Lax first-party: the API and the app share
  // an origin. `run_worker_first` keeps /api/* off the asset router, and the SPA
  // fallback hands every other unmatched path to index.html for React Router.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Created in the ENAM region (the agency and its clients are all in Michigan).
  // Recreate elsewhere with `npx wrangler d1 create midigitalexpansion-crm` and
  // paste the returned id here — builds deploy what is committed, so this value
  // has to live in the repo.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midigitalexpansion-crm",
      "database_id": "c76d91ea-063a-4995-8ece-0727ca578e90",
      "migrations_dir": "migrations"
    }
  ],

  // File uploads are off until R2 is enabled on the account, which is a one-time
  // opt-in in the dashboard (Storage & Databases -> R2) that needs a payment
  // method; the API refuses bucket creation until then with error 10042. With no
  // bucket bound the Documents tab reports uploads disabled rather than erroring,
  // exactly as the S3 version did, so this is a feature switch rather than a
  // broken state. To turn uploads on:
  //
  //   npx wrangler r2 bucket create midigitalexpansion-crm-documents
  //
  // then uncomment the block below and redeploy.
  //
  // "r2_buckets": [
  //   {
  //     "binding": "DOCUMENTS",
  //     "bucket_name": "midigitalexpansion-crm-documents"
  //   }
  // ],

  // Cron triggers fire in UTC. 10:00 UTC is 06:00 Eastern during EDT, which is
  // the 6am the automation engine was always specified to run at.
  "triggers": {
    "crons": ["0 10 * * *"]
  },

  "vars": {
    "APP_ENV": "production",
    "MAIL_FROM": "MiDigitalExpansion CRM <crm@midigitalexpansion.com>",
    // Set when the R2 bucket is served from a public custom domain. Leave empty
    // and documents stream back through the Worker instead.
    "R2_PUBLIC_BASE_URL": "",
    // Only needed if you ever serve the frontend from a different origin than
    // this Worker. Same-origin (the default) needs no CORS at all.
    "CORS_ORIGIN": ""
  }

  // Secrets — never commit these. Set with `npx wrangler secret put <NAME>`:
  //   JWT_SECRET         (required, 16+ chars)
  //   AUTOMATION_SECRET  (optional, guards POST /api/internal/run-automation)
  //   SEED_SECRET        (optional, guards POST /api/internal/seed)
  //   RESEND_API_KEY     (optional, enables notification emails)
}
