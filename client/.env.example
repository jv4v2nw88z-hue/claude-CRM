# Leave this empty.
#
# In development, vite.config.ts proxies /api to `wrangler dev` on :8787.
# In production the Worker serves this build and the API from one origin, so
# relative /api paths are already correct — which is what keeps the session
# cookie first-party.
#
# Only set it if you deliberately host the frontend somewhere other than the
# Worker, in which case also add that origin to CORS_ORIGIN in wrangler.jsonc.
VITE_API_BASE_URL=
